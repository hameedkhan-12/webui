{
  "name": "webra-monorepo",
  "version": "1.0.0",
  "description": "Webra monorepo with NestJS backend, Next.js frontend, and Prisma ORM",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:editor": "pnpm --filter @aura/editor dev",
    "dev:preview": "pnpm --filter @aura/preview dev",
    "dev:gateway": "pnpm --filter @aura/gateway dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "type-check": "turbo type-check",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "check:circular": "madge --circular --extensions ts packages/shared/src packages/aura-kernel/src packages/component-registry/src packages/schema-engine/src packages/ast-engine/src packages/persistence/src packages/plugins/src",
    "clean": "turbo clean && pnpm -r clean"
  },
  "keywords": [
    "monorepo",
    "turborepo",
    "nestjs",
    "nextjs",
    "prisma",
    "clerk",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.8.0",
  "devDependencies": {
    "madge": "^8.0.0",
    "turbo": "^2.7.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  }
}
